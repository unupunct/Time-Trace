<Window x:Class="TimeTrace.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to TimeTrace" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        Icon="Assets/TimeTrace.ico">
    <StackPanel Margin="30,26,30,26">
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/TimeTrace.png" Width="48" Height="48"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Welcome to TimeTrace" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Understand where your time goes." Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,20,0,0" LineHeight="20"
                   Text="TimeTrace measures how long each application is in the foreground on this computer, and shows it as timelines and reports."/>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="What it records" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="The active application, its window title (you can switch this off), and idle periods."/>
                <TextBlock Text="What it never does" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" Text="No keystrokes, mouse tracking, screenshots, clipboard, microphone or webcam. No account, no cloud, no telemetry. Data never leaves this PC."/>
                <TextBlock Text="You stay in control" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Pause or stop at any time, exclude applications or window titles, and delete or export all data."/>
            </StackPanel>
        </Border>
        <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" Content="Also start TimeTrace when I sign in to Windows" Margin="0,16,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Not now" Click="OnDecline" Margin="0,0,10,0" Padding="18,9"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Start tracking" Click="OnAccept" Padding="20,9" Margin="0" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
