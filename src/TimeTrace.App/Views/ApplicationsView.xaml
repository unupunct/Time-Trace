<UserControl x:Class="TimeTrace.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimeTrace.App.Controls">
    <Grid>
        <!-- ============================== list ============================== -->
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource InvBool}}" Margin="0,0,16,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Applications" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}" Margin="0,0,10,0">
                        <DatePicker SelectedDate="{Binding CustomFrom}" Width="130"/><TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/><DatePicker SelectedDate="{Binding CustomTo}" Width="130"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" Width="160"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="280" Tag="Search by name or executable…" ToolTip="Search by name or executable" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" Width="180" Margin="0,0,16,0"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Show excluded only" IsChecked="{Binding ShowExcludedOnly}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent"
                          BorderThickness="0" RowHeight="40" CanUserAddRows="False" SelectionMode="Single" CanUserResizeRows="False" MouseDoubleClick="OnRowDoubleClick" x:Name="Grid">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="46" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Grid Width="28" Height="28">
                                    <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding IconPath, Converter={StaticResource IconPath}}" Width="24" Height="24"/>
                                </Grid>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Executable" Binding="{Binding Executable}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total usage" Binding="{Binding TotalText}" SortMemberPath="TotalSeconds" Width="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Avg. session" Binding="{Binding AverageText}" SortMemberPath="AverageSeconds" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedText}" SortMemberPath="LastUsedUtc" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Category" Width="170" SortMemberPath="Category.Name">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" Margin="2" MinWidth="140"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Excluded" Width="100" SortMemberPath="IsExcluded">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding IsExcluded, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="Exclude this application from tracking"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="Details" Style="{StaticResource GhostButton}" Foreground="{DynamicResource AccentBrush}"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============================== detail ============================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="0,0,16,24">
                <Button Style="{StaticResource GhostButton}" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Left" Margin="-10,0,0,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0"/><TextBlock Text="All applications"/></StackPanel>
                </Button>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" Margin="0,0,16,0">
                        <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Detail.IconPath, Converter={StaticResource IconPath}}" Width="44" Height="44"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Detail.Name}" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"><Run Text="{Binding Detail.Executable, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PathText, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Detail.Categories}" SelectedItem="{Binding Detail.Category}" DisplayMemberPath="Name" Width="170" Margin="0,0,12,0"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Exclude from tracking" IsChecked="{Binding Detail.IsExcluded}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="Delete history" Command="{Binding DeleteAllForAppCommand}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Usage today" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TodayText}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Usage this week" Style="{StaticResource Muted}"/><TextBlock Text="{Binding WeekText}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Usage this month" Style="{StaticResource Muted}"/><TextBlock Text="{Binding MonthText}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="In selected period" Style="{StaticResource Muted}"/><TextBlock Text="{Binding RangeTotalText}" Style="{StaticResource StatValue}" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Average session" Style="{StaticResource Muted}"/><TextBlock Text="{Binding AvgText}" Style="{StaticResource StatValue}" FontSize="18" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Longest session" Style="{StaticResource Muted}"/><TextBlock Text="{Binding LongestText}" Style="{StaticResource StatValue}" FontSize="18" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="First activity in period" Style="{StaticResource Muted}"/><TextBlock Text="{Binding FirstText}" Style="{StaticResource StatValue}" FontSize="15" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Last activity in period" Style="{StaticResource Muted}"/><TextBlock Text="{Binding LastText}" Style="{StaticResource StatValue}" FontSize="15" Margin="0,6,0,0"/></StackPanel></Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Daily usage" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <c:BarChart Items="{Binding DetailBars}" Height="200"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Session history" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0" RowHeight="34" MaxHeight="420" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" SortMemberPath="StartUtc"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeRange}" Width="140" SortMemberPath="StartUtc"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90" SortMemberPath="DurationSeconds"/>
                            <DataGridTextColumn Header="Window title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
