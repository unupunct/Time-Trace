<UserControl x:Class="TimeTrace.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="About" Style="{StaticResource H1}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/TimeTrace.png" Width="84" Height="84"/>
                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TimeTrace" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Tagline}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,6"/>
                        <TextBlock Style="{StaticResource Muted}"><Run Text="Version "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  ·  Windows 10/11 x64  ·  MIT License"/></TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy by design" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="21">
                        TimeTrace is local-first. All activity data is stored in a database on this computer and is never sent anywhere: there is no account, no cloud
                        synchronisation, no telemetry and no analytics. It records only the foreground application, its window title (optional) and idle periods. It does not
                        record keystrokes, mouse movement, screenshots, clipboard contents, audio or video. You can pause, exclude applications, delete data and export it at any time.
                    </TextBlock>
                    <TextBlock Text="Categories are classifications you define. TimeTrace does not judge whether your time was productive." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Your data" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="Data folder: "/><Run Text="{Binding DataFolder, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10"><Run Text="Database: "/><Run Text="{Binding DatabaseFile, Mode=OneWay}"/></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Open-source licence" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Third-party components" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ThirdParty}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
