<UserControl x:Class="TimeTrace.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Margin" Value="50,-4,0,8"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,32" Binding.SourceUpdated="OnSourceUpdated" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,16" MinHeight="18"/>

            <!-- GENERAL -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Start TimeTrace when Windows starts" IsChecked="{Binding Draft.StartWithWindows, NotifyOnSourceUpdated=True}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Adds a per-user startup entry (no administrator rights). It is off until you turn it on."/>
                    <CheckBox Style="{StaticResource Switch}" Content="Start minimized to the system tray" IsChecked="{Binding Draft.StartMinimized, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Minimize to the system tray" IsChecked="{Binding Draft.MinimizeToTray, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Closing the window keeps TimeTrace running in the tray" IsChecked="{Binding Draft.CloseToTray, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Start tracking automatically when TimeTrace opens" IsChecked="{Binding Draft.AutoStartTracking, NotifyOnSourceUpdated=True}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Language" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding Draft.Language, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="200,4,0,0" Text="English is the only language shipped with this version."/>
                </StackPanel>
            </Border>

            <!-- TRACKING -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tracking" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Tracking enabled" IsChecked="{Binding Draft.TrackingEnabled, NotifyOnSourceUpdated=True}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Turn this off to disable tracking completely. Nothing is recorded until you turn it on again."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Polling interval" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding PollChoices}" SelectedValue="{Binding Draft.PollIntervalSeconds, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Idle after" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding IdleChoices}" SelectedValue="{Binding IdleChoice}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomIdle, Converter={StaticResource BoolVis}}" Margin="12,0,0,0">
                            <TextBox Text="{Binding CustomIdleMinutes, UpdateSourceTrigger=LostFocus}" Width="60"/>
                            <TextBlock Text="minutes (1–480)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="200,4,0,8" Text="After this much time without keyboard or mouse input, time is recorded as idle instead of belonging to an application."/>
                    <CheckBox Style="{StaticResource Switch}" Content="Include idle time in reports and totals" IsChecked="{Binding Draft.IncludeIdleInReports, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Record window titles" IsChecked="{Binding Draft.TrackWindowTitles, NotifyOnSourceUpdated=True}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="When off, titles are never stored (they are still used locally to apply your title exclusion rules)."/>
                    <CheckBox Style="{StaticResource Switch}" Content="Pause tracking while Windows is locked" IsChecked="{Binding Draft.PauseOnLock, NotifyOnSourceUpdated=True}"/>

                    <TextBlock Text="Excluded applications (executable names)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. keepass.exe"/>
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddExecutableCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExcludedExecutables}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="0" Command="{Binding DataContext.RemoveExecutableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Excluded paths" FontWeight="SemiBold" Margin="0,16,0,2"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Applications whose file path contains the text are ignored, e.g. \PrivateTools\" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddPathCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExcludedPaths}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="0" Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Excluded window title rules" FontWeight="SemiBold" Margin="0,16,0,2"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="Windows whose title contains the text are not recorded (case-insensitive). Start a rule with re: to use a regular expression, e.g. re:^Bank of .*"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewTitleRule, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddTitleRuleCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExcludedTitleRules}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="0" Command="{Binding DataContext.RemoveTitleRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DISPLAY -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Theme" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding Themes}" SelectedValue="{Binding Draft.Theme, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Accent colour" VerticalAlignment="Center" Width="200"/>
                        <ItemsControl ItemsSource="{Binding AccentPalette}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource ColorSwatch}" Background="{Binding Converter={StaticResource HexBrush}}" Margin="0,0,8,0" Width="26" Height="26"
                                        Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=LostFocus}" Width="90" Margin="8,0,0,0" MaxLength="7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Time format" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding TimeFormats}" SelectedValue="{Binding Draft.TimeFormat, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Date format" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding DateFormats}" SelectedValue="{Binding Draft.DateFormat, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Dashboard refresh" VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding RefreshChoices}" SelectedValue="{Binding Draft.DashboardRefreshSeconds, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200"/></StackPanel>
                </StackPanel>
            </Border>

            <!-- NOTIFICATIONS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Tracking started" IsChecked="{Binding Draft.NotifyTrackingStarted, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Tracking paused" IsChecked="{Binding Draft.NotifyTrackingPaused, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Daily summary (shown once after 18:00)" IsChecked="{Binding Draft.NotifyDailySummary, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Tracking errors" IsChecked="{Binding Draft.NotifyErrors, NotifyOnSourceUpdated=True}"/>
                </StackPanel>
            </Border>

            <!-- DATABASE -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Database" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Location" Style="{StaticResource Muted}"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,12"/>
                    <WrapPanel>
                        <Button Content="Change location…" Command="{Binding ChangeDatabaseLocationCommand}" Margin="0,0,8,8"/>
                        <Button Content="Back up database…" Command="{Binding BackupCommand}" Margin="0,0,8,8"/>
                        <Button Content="Restore from backup…" Command="{Binding RestoreCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export my data…" Command="{Binding ExportDataCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8"/>
                        <Button Content="Export settings…" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,8"/>
                        <Button Content="Import settings…" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Exports contain the sessions and window titles recorded on this computer. TimeTrace never uploads anything."/>
                </StackPanel>
            </Border>

            <!-- PRIVACY -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Show the tracking indicator in the sidebar" IsChecked="{Binding Draft.ShowTrackingIndicator, NotifyOnSourceUpdated=True}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Do not record window titles" IsChecked="{Binding Draft.TrackWindowTitles, Converter={StaticResource InvBool}, NotifyOnSourceUpdated=True}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Automatically delete data older than" VerticalAlignment="Center" Width="260"/>
                        <ComboBox ItemsSource="{Binding RetentionChoices}" SelectedValue="{Binding Draft.RetentionDays, NotifyOnSourceUpdated=True}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="160"/>
                        <Button Content="Apply now" Command="{Binding ApplyRetentionNowCommand}" Margin="12,0,0,0"/></StackPanel>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="What TimeTrace records" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Which application is in the foreground, its window title (optional), and when you were idle. Never keystrokes, mouse movement, screenshots, clipboard, microphone or webcam. Everything stays on this computer."/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource DangerButton}" Content="Delete all activity history…" Command="{Binding DeleteHistoryCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
