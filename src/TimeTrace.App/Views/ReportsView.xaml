<UserControl x:Class="TimeTrace.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimeTrace.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,24">
            <TextBlock Text="Reports" Style="{StaticResource H1}"/>
            <TextBlock Text="Generate and export reports. Files are written only to the folder you choose; nothing is uploaded." Style="{StaticResource Muted}" Margin="0,2,0,16"/>

            <!-- Generator -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Report type" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Period" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding AnchorDate}" Visibility="{Binding UsesAnchor, Converter={StaticResource BoolVis}}" HorizontalAlignment="Left" Width="170"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding UsesRange, Converter={StaticResource BoolVis}}">
                            <DatePicker SelectedDate="{Binding FromDate}" Width="150"/><TextBlock Text="–" VerticalAlignment="Center" Margin="8,0"/><DatePicker SelectedDate="{Binding ToDate}" Width="150"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="Format" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Destination folder" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Generate report" Command="{Binding GenerateCommand}" Padding="18,9"/>
                        <Button Content="Open file" Command="{Binding OpenFileCommand}" Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}"/>
                        <Button Content="Show in folder" Command="{Binding OpenFolderCommand}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview -->
            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,10"><Run Text="Preview · "/><Run Text="{Binding PeriodText, Mode=OneWay}"/></TextBlock>
            <UniformGrid Columns="4" Rows="2" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Total tracked" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TrackedText}" Style="{StaticResource StatValue}" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Active" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ActiveText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Idle" Style="{StaticResource Muted}"/><TextBlock Text="{Binding IdleText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Not observed" Style="{StaticResource Muted}"/><TextBlock Text="{Binding UnobservedText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Applications" Style="{StaticResource Muted}"/><TextBlock Text="{Binding AppsText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="App switches" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SwitchText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Avg. session" Style="{StaticResource Muted}"/><TextBlock Text="{Binding AvgText}" Style="{StaticResource StatValue}" FontSize="20" Margin="0,4,0,0"/></StackPanel></Border>
                <Border/>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel><TextBlock Text="{Binding BarTitle}" Style="{StaticResource H2}" Margin="0,0,0,8"/><c:BarChart Items="{Binding Bars}" Height="210"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Category distribution" Style="{StaticResource H2}"/>
                        <c:DonutChart Items="{Binding Slices}" Height="150" Margin="0,8"/>
                        <ItemsControl ItemsSource="{Binding Legend}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Muted}"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Hourly activity heatmap" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <c:HeatmapChart Data="{Binding Heatmap}" Height="200"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Historical comparison" Style="{StaticResource H2}" Margin="0,0,0,4"/>
            <TextBlock Text="Comparisons use tracked time only. A period without data is shown as such, not as zero." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Comparisons}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                <TextBlock Style="{StaticResource StatValue}" FontSize="20" Margin="0,6,0,2"><Run Text="{Binding CurrentText, Mode=OneWay}"/><Run Text="  vs  " FontSize="13" Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding PreviousText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                                <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Top applications in this period" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="14,8">
                <ItemsControl ItemsSource="{Binding TopApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank}" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Column="2" Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource ProgressTrack}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding PercentText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
